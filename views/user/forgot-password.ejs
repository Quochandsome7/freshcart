<div class="forgot-password-page">
    <div class="forgot-password-container">
        <div class="logo-section">
            <span class="logo-icon">🥬</span>
        </div>

        <h1 class="page-title">Quên mật khẩu</h1>
        <p class="page-subtitle">Nhập địa chỉ email bạn đã sử dụng để đăng ký tài khoản</p>

        <form class="forgot-form" id="forgotPasswordForm">
            <div class="form-group">
                <input type="email" name="email" placeholder="Nhập email của bạn" required>
            </div>

            <div class="form-group">
                <div class="captcha-container">
                    <input type="text" name="captcha" placeholder="Nhập mã xác nhận" maxlength="6" required>
                    <div class="captcha-display" id="captchaDisplay">
                        <span id="captchaCode"></span>
                        <button type="button" class="refresh-captcha" onclick="refreshCaptcha()">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                </div>
            </div>

            <button type="submit" class="submit-btn">
                Lấy lại mật khẩu
            </button>
        </form>

        <div class="form-footer">
            <a href="/login" class="back-link">Quay lại đăng nhập</a>
        </div>
    </div>
</div>

<style>
    .forgot-password-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        padding: 20px;
    }

    .forgot-password-container {
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        padding: 50px 40px;
        max-width: 450px;
        width: 100%;
    }

    .logo-section {
        text-align: center;
        margin-bottom: 20px;
    }

    .logo-icon {
        font-size: 48px;
        display: inline-block;
        animation: bounce 2s infinite;
    }

    @keyframes bounce {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .page-title {
        text-align: center;
        font-size: 28px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 10px;
    }

    .page-subtitle {
        text-align: center;
        color: #64748b;
        font-size: 14px;
        margin-bottom: 35px;
        line-height: 1.6;
    }

    .forgot-form {
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group input[type="email"] {
        width: 100%;
        padding: 14px 18px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 15px;
        transition: all 0.3s ease;
        outline: none;
    }

    .form-group input[type="email"]:focus {
        border-color: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
    }

    .captcha-container {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .captcha-container input[type="text"] {
        flex: 1;
        padding: 14px 18px;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 15px;
        transition: all 0.3s ease;
        outline: none;
    }

    .captcha-container input[type="text"]:focus {
        border-color: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
    }

    .captcha-display {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #f1f5f9;
        padding: 14px 16px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        min-width: 120px;
        justify-content: center;
    }

    .captcha-display span {
        font-size: 18px;
        font-weight: 700;
        letter-spacing: 4px;
        color: #22c55e;
        font-family: 'Courier New', monospace;
        text-decoration: line-through;
        user-select: none;
    }

    .refresh-captcha {
        background: none;
        border: none;
        color: #22c55e;
        cursor: pointer;
        padding: 4px;
        transition: transform 0.3s ease;
    }

    .refresh-captcha:hover {
        transform: rotate(180deg);
    }

    .submit-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(34, 197, 94, 0.3);
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(34, 197, 94, 0.4);
    }

    .submit-btn:active {
        transform: translateY(0);
    }

    .form-footer {
        text-align: center;
        margin-top: 20px;
    }

    .back-link {
        color: #22c55e;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        transition: color 0.3s ease;
    }

    .back-link:hover {
        color: #16a34a;
        text-decoration: underline;
    }

    .test-info {
        margin-top: 30px;
        padding: 20px;
        background: #fef3c7;
        border-radius: 10px;
        border: 2px solid #fbbf24;
        text-align: center;
    }

    .test-info p {
        margin: 5px 0;
        color: #92400e;
        font-size: 13px;
    }

    .test-info i {
        color: #f59e0b;
    }

    @media (max-width: 480px) {
        .forgot-password-container {
            padding: 40px 25px;
        }

        .captcha-container {
            flex-direction: column;
        }

        .captcha-display {
            width: 100%;
        }
    }
</style>

<script>
    // Generate random captcha
    function generateCaptcha() {
        const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789';
        let captcha = '';
        for (let i = 0; i < 6; i++) {
            captcha += chars.charAt(Math.floor(Math.random() * chars.length));
        }
        return captcha;
    }

    let currentCaptcha = generateCaptcha();

    function refreshCaptcha() {
        currentCaptcha = generateCaptcha();
        document.getElementById('captchaCode').textContent = currentCaptcha;
    }

    // Initialize captcha on page load
    document.addEventListener('DOMContentLoaded', function () {
        refreshCaptcha();
    });

    // Handle form submit
    document.getElementById('forgotPasswordForm').addEventListener('submit', function (e) {
        e.preventDefault();

        const email = this.email.value;
        const captcha = this.captcha.value;

        // Validate captcha
        if (captcha !== currentCaptcha) {
            alert('Mã xác nhận không đúng! Vui lòng thử lại.');
            refreshCaptcha();
            this.captcha.value = '';
            return;
        }

        // For demo purposes, show message
        alert('Đây là phiên bản demo. Vui lòng sử dụng tài khoản test:\n\n' +
            'Admin: admin@freshcart.vn / admin123\n' +
            'Customer: customer@example.com / customer123\n\n' +
            'Hoặc liên hệ: 0348778086');

        // Redirect to login
        window.location.href = '/login';
    });
</script>