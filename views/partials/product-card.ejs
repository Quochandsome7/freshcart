<article class="product-card">
    <% if (product.originalPrice && product.originalPrice> product.price) { %>
        <span class="product-badge badge-sale">-<%= Math.round((1 - product.price / product.originalPrice) * 100) %>
                %</span>
        <% } %>
            <% if (product.organicType==='100% Organic' ) { %>
                <span class="product-badge badge-organic">Organic</span>
                <% } %>

                    <a href="/products/<%= product.id %>" class="product-image">
                        <img src="<%= product.images && product.images[0] ? product.images[0] : '/images/product-placeholder.jpg' %>"
                            alt="<%= product.name %>"
                            onerror="this.src='https://placehold.co/300x300/f1f5f9/475569?text=<%= encodeURIComponent(product.name) %>'">
                    </a>

                    <div class="product-info">
                        <% if (product.category) { %>
                            <span class="product-category">
                                <%= product.category.name %>
                            </span>
                            <% } %>

                                <h3 class="product-name">
                                    <a href="/products/<%= product.id %>">
                                        <%= product.name %>
                                    </a>
                                </h3>

                                <div class="product-price">
                                    <span class="current-price">
                                        <%= formatCurrency(product.price) %>
                                    </span>
                                    <% if (product.originalPrice && product.originalPrice> product.price) { %>
                                        <span class="original-price">
                                            <%= formatCurrency(product.originalPrice) %>
                                        </span>
                                        <% } %>
                                </div>

                                <div class="product-meta">
                                    <span class="product-weight">
                                        <%= product.weight %>
                                            <%= product.unit %>
                                    </span>
                                    <% if (product.stock <=10 && product.stock> 0) { %>
                                        <span class="low-stock">Còn <%= product.stock %> sản phẩm</span>
                                        <% } else if (product.stock===0) { %>
                                            <span class="out-of-stock">Hết hàng</span>
                                            <% } %>
                                </div>

                                <div class="product-actions">
                                    <% if (product.stock> 0) { %>
                                        <form action="/cart/add" method="POST" class="add-to-cart-form">
                                            <input type="hidden" name="productId" value="<%= product.id %>">
                                            <input type="hidden" name="quantity" value="1">
                                            <button type="submit" class="btn btn-primary btn-add-cart">
                                                <i class="fas fa-cart-plus"></i> Thêm vào giỏ
                                            </button>
                                        </form>
                                        <% } else { %>
                                            <button class="btn btn-disabled" disabled>Hết hàng</button>
                                            <% } %>
                                </div>
                    </div>
</article>