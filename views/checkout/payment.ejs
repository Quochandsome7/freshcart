<div class="checkout-page">
    <div class="container">
        <!-- Checkout Steps -->
        <div class="checkout-steps">
            <div class="step completed">
                <span class="step-number"><i class="fas fa-check"></i></span>
                <span class="step-text">Thông tin giao hàng</span>
            </div>
            <div class="step completed">
                <span class="step-number"><i class="fas fa-check"></i></span>
                <span class="step-text">Vận chuyển</span>
            </div>
            <div class="step active">
                <span class="step-number">3</span>
                <span class="step-text">Thanh toán</span>
            </div>
        </div>

        <div class="checkout-layout">
            <div class="checkout-form-section">
                <h2>Chọn phương thức thanh toán</h2>

                <div class="order-preview">
                    <div class="preview-section">
                        <h4><i class="fas fa-map-marker-alt"></i> Giao đến:</h4>
                        <p><strong>
                                <%= shippingInfo.customerName %>
                            </strong></p>
                        <p>
                            <%= shippingInfo.shippingAddress %>
                        </p>
                        <p>SĐT: <%= shippingInfo.customerPhone %>
                        </p>
                    </div>
                    <div class="preview-section">
                        <h4><i class="fas fa-truck"></i> Vận chuyển:</h4>
                        <p>
                            <% if (selectedCarrier==='ghtk' ) { %>
                                Giao Hàng Tiết Kiệm
                                <% } else { %>
                                    Viettel Post
                                    <% } %>
                                        - <%= formatCurrency(shippingFee) %>
                        </p>
                    </div>
                </div>

                <form action="/checkout/place-order" method="POST" class="payment-form">
                    <div class="payment-options">
                        <label class="payment-option selected">
                            <input type="radio" name="paymentMethod" value="cod" checked>
                            <div class="option-content">
                                <div class="option-icon">
                                    <i class="fas fa-money-bill-wave"></i>
                                </div>
                                <div class="option-info">
                                    <span class="option-name">Thanh toán khi nhận hàng (COD)</span>
                                    <span class="option-desc">Bạn sẽ thanh toán khi nhận được hàng</span>
                                </div>
                            </div>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="vnpay">
                            <div class="option-content">
                                <div class="option-icon">
                                    <img src="/images/vnpay.png" alt="VNPay"
                                        onerror="this.outerHTML='<i class=\'fas fa-credit-card\'></i>'">
                                </div>
                                <div class="option-info">
                                    <span class="option-name">VNPay</span>
                                    <span class="option-desc">Thanh toán qua thẻ ATM, Visa, Master, QR Code</span>
                                </div>
                            </div>
                        </label>

                        <label class="payment-option">
                            <input type="radio" name="paymentMethod" value="momo">
                            <div class="option-content">
                                <div class="option-icon">
                                    <img src="/images/momo.png" alt="MoMo"
                                        onerror="this.outerHTML='<i class=\'fas fa-mobile-alt\'></i>'">
                                </div>
                                <div class="option-info">
                                    <span class="option-name">Ví MoMo</span>
                                    <span class="option-desc">Thanh toán qua ví điện tử MoMo</span>
                                </div>
                            </div>
                        </label>

                        <label class="payment-option" id="bankTransferOption">
                            <input type="radio" name="paymentMethod" value="bank_transfer">
                            <div class="option-content">
                                <div class="option-icon">
                                    <i class="fas fa-university"></i>
                                </div>
                                <div class="option-info">
                                    <span class="option-name">Chuyển khoản ngân hàng</span>
                                    <span class="option-desc">Chuyển khoản qua tài khoản ngân hàng - Hỗ trợ QR
                                        Code</span>
                                </div>
                            </div>
                        </label>

                        <!-- Bank selector panel -->
                        <div class="bank-selector-panel" id="bankSelectorPanel" style="display: none;">
                            <h4><i class="fas fa-landmark"></i> Chọn ngân hàng của bạn:</h4>
                            <input type="hidden" name="selectedBank" id="selectedBankInput" value="VCB">
                            <div class="bank-grid">
                                <div class="bank-item selected" data-bank="VCB" onclick="selectBank(this, 'VCB')">
                                    <img src="https://api.vietqr.io/img/VCB.png" alt="Vietcombank"
                                        onerror="this.style.display='none'">
                                    <span>Vietcombank</span>
                                </div>
                                <div class="bank-item" data-bank="TCB" onclick="selectBank(this, 'TCB')">
                                    <img src="https://api.vietqr.io/img/TCB.png" alt="Techcombank"
                                        onerror="this.style.display='none'">
                                    <span>Techcombank</span>
                                </div>
                                <div class="bank-item" data-bank="MB" onclick="selectBank(this, 'MB')">
                                    <img src="https://api.vietqr.io/img/MB.png" alt="MB Bank"
                                        onerror="this.style.display='none'">
                                    <span>MB Bank</span>
                                </div>
                                <div class="bank-item" data-bank="BIDV" onclick="selectBank(this, 'BIDV')">
                                    <img src="https://api.vietqr.io/img/BIDV.png" alt="BIDV"
                                        onerror="this.style.display='none'">
                                    <span>BIDV</span>
                                </div>
                                <div class="bank-item" data-bank="VBA" onclick="selectBank(this, 'VBA')">
                                    <img src="https://api.vietqr.io/img/VBA.png" alt="Agribank"
                                        onerror="this.style.display='none'">
                                    <span>Agribank</span>
                                </div>
                                <div class="bank-item" data-bank="VPB" onclick="selectBank(this, 'VPB')">
                                    <img src="https://api.vietqr.io/img/VPB.png" alt="VPBank"
                                        onerror="this.style.display='none'">
                                    <span>VPBank</span>
                                </div>
                                <div class="bank-item" data-bank="ACB" onclick="selectBank(this, 'ACB')">
                                    <img src="https://api.vietqr.io/img/ACB.png" alt="ACB"
                                        onerror="this.style.display='none'">
                                    <span>ACB</span>
                                </div>
                                <div class="bank-item" data-bank="TPB" onclick="selectBank(this, 'TPB')">
                                    <img src="https://api.vietqr.io/img/TPB.png" alt="TPBank"
                                        onerror="this.style.display='none'">
                                    <span>TPBank</span>
                                </div>
                                <div class="bank-item" data-bank="STB" onclick="selectBank(this, 'STB')">
                                    <img src="https://api.vietqr.io/img/STB.png" alt="Sacombank"
                                        onerror="this.style.display='none'">
                                    <span>Sacombank</span>
                                </div>
                                <div class="bank-item" data-bank="VIB" onclick="selectBank(this, 'VIB')">
                                    <img src="https://api.vietqr.io/img/VIB.png" alt="VIB"
                                        onerror="this.style.display='none'">
                                    <span>VIB</span>
                                </div>
                                <div class="bank-item" data-bank="HDB" onclick="selectBank(this, 'HDB')">
                                    <img src="https://api.vietqr.io/img/HDB.png" alt="HDBank"
                                        onerror="this.style.display='none'">
                                    <span>HDBank</span>
                                </div>
                                <div class="bank-item" data-bank="SHB" onclick="selectBank(this, 'SHB')">
                                    <img src="https://api.vietqr.io/img/SHB.png" alt="SHB"
                                        onerror="this.style.display='none'">
                                    <span>SHB</span>
                                </div>
                                <div class="bank-item" data-bank="MSB" onclick="selectBank(this, 'MSB')">
                                    <img src="https://api.vietqr.io/img/MSB.png" alt="MSB"
                                        onerror="this.style.display='none'">
                                    <span>MSB</span>
                                </div>
                                <div class="bank-item" data-bank="OCB" onclick="selectBank(this, 'OCB')">
                                    <img src="https://api.vietqr.io/img/OCB.png" alt="OCB"
                                        onerror="this.style.display='none'">
                                    <span>OCB</span>
                                </div>
                                <div class="bank-item" data-bank="LPB" onclick="selectBank(this, 'LPB')">
                                    <img src="https://api.vietqr.io/img/LPB.png" alt="LPBank"
                                        onerror="this.style.display='none'">
                                    <span>LPBank</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="terms-agreement">
                        <label class="checkbox-label">
                            <input type="checkbox" required>
                            <span>Tôi đồng ý với <a href="/terms" target="_blank">Điều khoản dịch vụ</a> và <a
                                    href="/privacy" target="_blank">Chính sách bảo mật</a></span>
                        </label>
                    </div>

                    <div class="form-actions">
                        <a href="/checkout/delivery" class="btn btn-outline">
                            <i class="fas fa-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-lock"></i> Đặt hàng - <%= formatCurrency(totalAmount) %>
                        </button>
                    </div>
                </form>
            </div>

            <div class="checkout-summary">
                <h3>Chi tiết đơn hàng</h3>
                <div class="summary-items">
                    <% cart.items.forEach(item=> { %>
                        <div class="summary-item">
                            <img src="<%= item.image %>" alt="<%= item.name %>"
                                onerror="this.src='https://placehold.co/60x60/f1f5f9/475569?text=P'">
                            <div class="item-info">
                                <span class="item-name">
                                    <%= item.name %>
                                </span>
                                <span class="item-qty">x<%= item.quantity %></span>
                            </div>
                            <span class="item-total">
                                <%= formatCurrency(item.price * item.quantity) %>
                            </span>
                        </div>
                        <% }); %>
                </div>
                <hr>
                <div class="summary-row">
                    <span>Tạm tính:</span>
                    <span>
                        <%= formatCurrency(cart.subtotal) %>
                    </span>
                </div>
                <div class="summary-row">
                    <span>Phí vận chuyển:</span>
                    <span>
                        <%= formatCurrency(shippingFee) %>
                    </span>
                </div>
                <hr>
                <div class="summary-row total">
                    <span>Tổng cộng:</span>
                    <span class="total-amount">
                        <%= formatCurrency(totalAmount) %>
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .bank-selector-panel {
        background: #f0fdf4;
        border: 2px solid #22c55e;
        border-radius: 12px;
        padding: 1.2rem;
        margin-top: 0.5rem;
        animation: slideDown 0.3s ease;
    }

    @keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-10px);
            max-height: 0;
        }

        to {
            opacity: 1;
            transform: translateY(0);
            max-height: 600px;
        }
    }

    .bank-selector-panel h4 {
        margin: 0 0 0.8rem 0;
        color: #166534;
        font-size: 0.95rem;
        font-weight: 600;
    }

    .bank-selector-panel h4 i {
        margin-right: 0.4rem;
        color: #22c55e;
    }

    .bank-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 0.6rem;
    }

    .bank-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.7rem 0.4rem;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #fff;
        min-height: 70px;
    }

    .bank-item:hover {
        border-color: #22c55e;
        background: #f0fdf4;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(34, 197, 94, 0.15);
    }

    .bank-item.selected {
        border-color: #22c55e;
        background: #dcfce7;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
    }

    .bank-item img {
        height: 28px;
        width: auto;
        max-width: 80px;
        object-fit: contain;
    }

    .bank-item span {
        font-size: 0.75rem;
        font-weight: 600;
        color: #334155;
        text-align: center;
        line-height: 1.2;
    }

    .bank-item.selected span {
        color: #166534;
    }

    @media (max-width: 600px) {
        .bank-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }
</style>

<script>
    // Payment option selection
    document.querySelectorAll('.payment-option input').forEach(radio => {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.payment-option').forEach(opt => opt.classList.remove('selected'));
            this.closest('.payment-option').classList.add('selected');

            // Show/hide bank selector panel
            const bankPanel = document.getElementById('bankSelectorPanel');
            if (this.value === 'bank_transfer') {
                bankPanel.style.display = 'block';
            } else {
                bankPanel.style.display = 'none';
            }
        });
    });

    // Bank selection
    function selectBank(element, bankCode) {
        document.querySelectorAll('.bank-item').forEach(item => item.classList.remove('selected'));
        element.classList.add('selected');
        document.getElementById('selectedBankInput').value = bankCode;
    }
</script>